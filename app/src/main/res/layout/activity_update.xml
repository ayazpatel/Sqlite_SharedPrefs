<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Update">

    <!-- Spinner for Selecting ID -->
    <Spinner
        android:id="@+id/spinnerId1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_centerHorizontal="true" />

    <!-- EditText for Age Input -->
    <EditText
        android:id="@+id/edtAge_update"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter New Age"
        android:inputType="number"
        android:layout_below="@id/spinnerId1"
        android:layout_marginTop="20dp"
        android:layout_centerHorizontal="true" />

    <!-- Button to Update Age -->
    <Button
        android:id="@+id/btnUpdate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Update Age"
        android:layout_below="@id/edtAge_update"
        android:layout_marginTop="20dp"
        android:layout_centerHorizontal="true" />

</RelativeLayout>
